		justify-content: center;
	}
	.search_input_left_text{
		font-size: 24rpx;
		color:#AAA;
	}
	
	.search_input_scan{
		width:70rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border-left: 1px solid #FFF;
	}

	.swiper {
		flex: 1;
	}

	.swiper-item {
		width: 100%;
	}

	.logo {
		width: 80rpx;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.menu_container{
		width:100%;
		height:100%;
		background: transparent;
		position: absolute;
		top:0px;
		bottom:0px;
		left:0px;
		right:0px;
		z-index:999;
	}
	.right_menu{
		position: absolute;
		top:80rpx;
		margin-top: var(--status-bar-height);
		display: flex;
		flex-direction: column;
		right:6rpx;
		background: #EAEAEA;
		// #f0f0f0
		border-radius: 10rpx;
		padding-left: 10rpx;
		padding-right: 10rpx;
		padding-bottom: 10rpx;
	}
	.menu_item{
		height:80rpx;
		width:200rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		padding-left: 20rpx;
	}
	.menu_item_border{
		border-bottom: #FFF 1px solid;
	}
